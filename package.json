{
  "name": "divergency-reviewer-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build-reviewer-html.mjs",
    "build:online": "node online/prepare.mjs && vite build",
    "dev:online": "node online/prepare.mjs && vite --host 127.0.0.1",
    "db:generate": "drizzle-kit generate",
    "edit": "node scripts/editor-server.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "drizzle-kit": "0.31.10",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
